# Copy to server/.env for `npm run dev:server` (git-ignored). On Render, set these on the API service instead.
ANTHROPIC_API_KEY=
# claude-opus-5 by default; claude-sonnet-5 or claude-haiku-4-5 cost less (see docs/ai-assistant/build-notes.md).
AI_MODEL=
# 1 = canned demo replies and no API calls, for running the page without a key.
AI_MOCK=1
# The site's origin(s), comma-separated. Unset allows only local vite (localhost:5173 and :4173).
ALLOWED_ORIGINS=
# AI requests allowed per hour across everyone (default 300).
AI_MAX_PER_HOUR=
